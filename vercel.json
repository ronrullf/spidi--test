{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/autopago", "destination": "/autopago.html" },
    { "source": "/kiosco", "destination": "/autopago.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/chat", "destination": "/chat.html" },
    { "source": "/whatsapp", "destination": "/chat.html" },
    { "source": "/simulador", "destination": "/chat.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/factura", "destination": "/factura.html" },
    { "source": "/error-pago", "destination": "/error-pago.html" },
    { "source": "/resultado", "destination": "/resultado.html" },
    { "source": "/envio", "destination": "/factura.html" },
    { "source": "/api/(.*)", "destination": "/api/index.js?route=$1" }
  ]
}
